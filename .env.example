# ── Slot Engine ortam değişkenleri (kopyala: .env.local / servis ortamı) ──

# SQLite denetim veritabanı yolu (varsayılan: .data/slot.db)
# Yedekleme/izin bu dosyaya bağlı — mutlaka sabit bir disk yolunda tutun.
#SLOT_DB_PATH=D:/var/slot-engine/slot.db

# Config versiyon snapshot dizini (varsayılan: .data/config-versions)
# Her binary ilk turda kendi oyun verisinin snapshot'ını buraya yazar;
# eski turların denetimi için ESKİ dosyalar silinmemeli (bkz. docs/DEPLOYMENT.md).
#SLOT_CONFIG_VERSIONS_DIR=D:/var/slot-engine/config-versions

# Demo force QA kapısı (?force=link|fs).
# production'da (NODE_ENV=production) varsayılan KAPALI;
# yalnızca bu değer "1" ise açık. Lisanslı yayında ASLA "1" yapmayın.
#SLOT_ALLOW_FORCE=0

# KYC politikası: "1" → anonim oyun TAMAMEN kapalı; yalnızca
# kyc_status=verified oyuncu tur oynayabilir (lisanslı yayında "1").
#SLOT_REQUIRE_KYC=1

# Denetim uzak kopya uç noktası (`npm run audit:export -- --ship`).
# Hash-zincirli JSONL bu adrese POST edilir (2xx beklenir).
#SLOT_AUDIT_SINK=https://audit.example.com/ingest

# Next.js production sunucusu (npm start bunu zorlar)
#NODE_ENV=production
